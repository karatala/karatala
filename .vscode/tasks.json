{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Configure",
      "type": "shell",
      "command": "cmake -S . -B build",
    },
    {
      "label": "Build",
      "type": "shell",
      "command": "cmake --build build",
      "dependsOn": "Configure",
      "group": {
        "kind": "build"
      },
      "problemMatcher": "$gcc",
    },
    {
      "label": "Run Standalone",
      "type": "shell",
      "command": "killall Karatala; ./build/Karatala_artefacts/Standalone/Karatala.app/Contents/MacOS/Karatala",
      "dependsOn": "Build",
    },
    {
      "label": "Validate plugin using pluginval",
      "type": "shell",
      "command": "/Applications/pluginval.app/Contents/MacOS/pluginval --validate ./build/Karatala_artefacts",
      "dependsOn": "Build",
    },
  ]
}
