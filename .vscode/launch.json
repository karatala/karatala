{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "(MacOS) Debug in REAPER",
      "type": "cppdbg",
      "request": "launch",
      "program": "/Applications/REAPER.app",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${fileDirname}",
      "environment": [],
      "externalConsole": false,
      "MIMode": "lldb"
    },
    {
      "name": "(Windows) Debug Standalone",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/Karatala_artefacts/Debug/Standalone/Karatala Drum Kit Engine.exe",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${fileDirname}",
      "environment": [],
      // "preLaunchTask": "Build Standalone",
      "internalConsoleOptions": "openOnSessionStart",
    },
    {
      "name": "(Windows) Debug Tests",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/Debug/Tests.exe",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${fileDirname}",
      "environment": [],
      "preLaunchTask": "Build tests",
      "internalConsoleOptions": "openOnSessionStart",
      // "console": "integratedTerminal",
    },
    {
      "name": "(Windows) Debug in REAPER",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "T:\\apps\\MultiMedia\\ReaperPortable\\App\\Reaper\\reaper.exe",
      "args": [
        "-cfgfile",
        "t:\\apps\\MultiMedia\\ReaperPortable\\Data\\ReaperPortableConfig\\reaper.ini"
      ],
      "stopAtEntry": false,
      "cwd": "t:\\apps\\MultiMedia\\ReaperPortable\\Data\\ReaperPortableConfig",
      "internalConsoleOptions": "openOnSessionStart",
      // "preLaunchTask": "Build VST3",
      "environment": [],
      "logging": {
          "moduleLoad": false,
          "programOutput": true,
          "trace": false,
      }
    },
    {
      "name": "(Windows) Attach to process",
      "type": "cppvsdbg",
      "request": "attach",
      "processId": "${command:pickProcess}",
      "internalConsoleOptions": "openOnSessionStart"
    }
  ],
}